# Copia questo file in .env.local e riempi i valori. .env.local NON va mai su GitHub.

# Indirizzo pubblico del sito (serve per i link privati ai report)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Claude (https://platform.claude.com). Senza chiave il sito usa report dimostrativi.
ANTHROPIC_API_KEY=

# Supabase (https://supabase.com), progetto in regione Europa.
# La service role key si usa SOLO lato server. Senza questi valori, in locale si usa la cartella .data.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Pannello /admin
ADMIN_PASSWORD=
# Stringa casuale lunga almeno 32 caratteri (es. `openssl rand -base64 48`)
ADMIN_SESSION_SECRET=

# Ordini pubblici (resta false fino alla Fase 3, quando arrivano i pagamenti)
NEXT_PUBLIC_ORDINI_APERTI=false

# Link affiliato carVertical (dichiarato come affiliato nel report)
NEXT_PUBLIC_CARVERTICAL_URL=https://www.carvertical.com/it
